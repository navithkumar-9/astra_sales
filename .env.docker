# ══════════════════════════════════════════════
# Astra Sales — Docker Environment Variables
# This file is used by docker-compose.yml
# ══════════════════════════════════════════════

# ──────────────────────────────────────────────
# MySQL
# ──────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=astra_user
MYSQL_PASSWORD=root@123
MYSQL_DB=astra_sales
MYSQL_ROOT_PASSWORD=root@123
MYSQL_DATABASE=astra_sales

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ──────────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ──────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=docker-dev-secret-key-change-in-production

# ──────────────────────────────────────────────
# Super Admin
# ──────────────────────────────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=super123

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=

# ──────────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=navithkumar.n@wyzmindz.com
EMAIL_HOST_PASSWORD=P0Zth76T2kLW
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=navithkumar.n@wyzmindz.com
